# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен для ручного запуска обхода: любая длинная случайная строка.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
STROY_ADMIN_TOKEN=

# Домен, если есть (Caddy сам выпустит HTTPS-сертификат). Без домена оставьте :80
SITE_ADDRESS=:80

# Как часто обновлять цены (часы)
STROY_SCRAPE_INTERVAL_HOURS=12
